# Security headers for the static export (Hostinger / LiteSpeed / Apache with mod_headers).
# The dashboard must not be framable; only the chat widget page (/widget/) may be embedded in other sites.
# Verify after each deploy:  curl -sI https://<app>/dashboard/ | grep -i -E "x-frame|content-security"
#                            curl -sI https://<app>/widget/    | grep -i -E "x-frame|content-security"   (must print nothing)
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  SetEnvIf Request_URI "^/widget(/|$)" vendly_embeddable=1
  Header always set X-Frame-Options "SAMEORIGIN" env=!vendly_embeddable
  Header always set Content-Security-Policy "frame-ancestors 'self'" env=!vendly_embeddable
</IfModule>
